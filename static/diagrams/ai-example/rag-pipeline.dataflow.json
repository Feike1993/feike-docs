      "route": "vertical-channel"
    },
    {
      "id": "ask",
      "from": "query",
      "to": "retrieve",
      "label": "查询",
      "classification": "在线",
      "variant": "emphasis",
      "route": "vertical-channel"
    },
    {
      "id": "vector-hit",
      "from": "pgvector",
      "to": "retrieve",
      "label": "相似片段",
      "classification": "在线",
      "variant": "emphasis",
      "route": "vertical-channel"
    },
    {
      "id": "hit-prompt",
      "from": "retrieve",
      "to": "prompt",
      "label": "检索上下文",
      "classification": "有结果",
      "variant": "emphasis",
      "route": "vertical-channel"
    },
    {
      "id": "empty-path",
      "from": "retrieve",
      "to": "refuse",
      "label": "无命中",
      "classification": "拒答",
      "variant": "security",
      "route": "straight",
      "labelDy": 24
    },
    {
      "id": "prompt-chat",
      "from": "prompt",
      "to": "chat",
      "label": "生成答案",
      "classification": "Chat≠Embed",
      "variant": "emphasis",
      "route": "straight",
      "labelDy": 24
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "离线与在线分离",
      "items": [
        "写入路径：语料 → 分块 → Embedding → pgvector",
        "查询路径：问题 → 检索 → Prompt → Chat",
        "两段管线共享向量库，但不共享模型调用"
      ]
    },
    {
      "dot": "rose",
      "title": "空检索不调用 Chat",
      "items": [
        "无相关片段时直接 EMPTY_REFUSAL",
        "避免模型用参数知识编造答案",
        "对应 RagSampleService 空检索分支"
      ]
    },
    {
      "dot": "orange",
      "title": "Chat 与 Embedding 解耦",
      "items": [
        "Embedding 固定 DashScope text-embedding-v3",
        "Chat 可换 DeepSeek / 通义等 OpenAI 兼容端",
        "维度与提供商独立配置，避免混用"
      ]
    }
  ]
}
