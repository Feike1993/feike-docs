{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "ai-example RAG 离线 / 在线管线",
    "locale": "zh-CN",
    "output": "rag-pipeline.html",
    "viewBox": [1068, 760],
    "quality_profile": "showcase",
    "views": [
