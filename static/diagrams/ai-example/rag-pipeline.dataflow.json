      "sublabel": "Token/语义",
      "stage": 1,
      "row": 1,
      "tag": "Service"
    },
    {
      "id": "embedding",
      "type": "cloud",
      "label": "Embedding",
      "sublabel": "DashScope",
      "stage": 1,
      "row": 0,
      "tag": "1024-d"
