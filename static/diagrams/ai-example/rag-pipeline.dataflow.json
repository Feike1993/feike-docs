        "note": "Markdown 语料分块后 Embedding，写入 pgvector。"
      },
      {
        "id": "online-retrieve",
        "label": "在线检索",
        "focus": ["query", "retrieve", "pgvector", "refuse"],
        "note": "问题向量检索；空结果走拒答，不调用 Chat。"
      },
      {
        "id": "grounded-generate",
        "label": "接地生成",
        "focus": ["retrieve", "prompt", "chat"],
        "note": "仅把检索上下文拼进 Prompt，再由 Chat 模型生成。"
      }
    ]
