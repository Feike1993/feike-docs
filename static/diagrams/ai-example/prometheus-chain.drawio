<mxfile host="app.diagrams.net">
  <diagram name="Prometheus 数据链路" id="prometheus-chain">
    <mxGraphModel dx="1200" dy="760" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="760">
